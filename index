<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>CFD Break-Even & Risk Calculator</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root {
      --bg: #0f172a;
      --bg-card: #020617;
      --bg-card-soft: #0b1220;
      --accent: #22c55e;
      --accent-soft: rgba(34, 197, 94, 0.15);
      --accent-red: #ef4444;
      --accent-red-soft: rgba(239, 68, 68, 0.12);
      --text: #e5e7eb;
      --muted: #9ca3af;
      --border: #1f2937;
      --font-sans: system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text",
        "Segoe UI", Roboto, sans-serif;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 0;
      font-family: var(--font-sans);
      background: radial-gradient(circle at top, #1e293b 0, #020617 50%, #000 100%);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      align-items: stretch;
      justify-content: center;
    }

    .app {
      width: 100%;
      max-width: 1200px;
      padding: 24px;
    }

    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      margin-bottom: 16px;
    }

    header h1 {
      font-size: 1.6rem;
      font-weight: 600;
      letter-spacing: 0.03em;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    header h1 span.logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 999px;
      background: radial-gradient(circle at 30% 20%, #4ade80, #16a34a 60%, #166534);
      color: #022c22;
      font-weight: 900;
      font-size: 1.1rem;
    }

    header p {
      margin: 0;
      font-size: 0.9rem;
      color: var(--muted);
      max-width: 460px;
    }

    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.1fr);
      gap: 20px;
    }

    @media (max-width: 900px) {
      .grid { grid-template-columns: minmax(0, 1fr); }
    }

    .card {
      background: linear-gradient(145deg, var(--bg-card-soft), var(--bg-card));
      border-radius: 20px;
      border: 1px solid var(--border);
      padding: 18px 20px 20px;
      box-shadow: 0 18px 45px rgba(0, 0, 0, 0.55);
    }

    .card h2 {
      margin: 0 0 12px;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .card h2 span.badge {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 3px 8px;
      border-radius: 999px;
      background: rgba(148, 163, 184, 0.1);
      color: var(--muted);
      border: 1px solid rgba(148, 163, 184, 0.4);
    }

    .inputs-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 14px;
    }

    @media (max-width: 600px) {
      .inputs-grid { grid-template-columns: minmax(0, 1fr); }
    }

    .field { display: flex; flex-direction: column; gap: 4px; font-size: 0.85rem; }

    label {
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      gap: 8px;
      align-items: baseline;
    }

    label span.hint {
      font-size: 0.72rem;
      color: #6b7280;
    }

    input, select {
      border-radius: 999px;
      padding: 8px 12px;
      border: 1px solid #1f2937;
      background: rgba(15, 23, 42, 0.9);
      color: var(--text);
      font-family: inherit;
      font-size: 0.9rem;
      outline: none;
      transition: border 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }

    input::placeholder { color: #6b7280; }

    input:focus, select:focus {
      border-color: #22c55e;
      box-shadow: 0 0 0 1px rgba(34, 197, 94, 0.45);
      background: rgba(15, 23, 42, 0.98);
    }

    /* ▶ VOLUME CONTROL PANEL */
    .volume-control {
      position: fixed;
      top: 16px;
      right: 16px;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid #1f2937;
      padding: 10px 14px;
      border-radius: 12px;
      backdrop-filter: blur(6px);
      color: #e5e7eb;
      font-size: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 4px;
      z-index: 9999;
    }

    .volume-control input[type="range"] {
      width: 120px;
      cursor: pointer;
      accent-color: #22c55e;
    }

    footer {
      margin-top: 14px;
      font-size: 0.78rem;
      color: #6b7280;
      text-align: right;
    }
  </style>
</head>
<body>

  <!-- 🔊 AUDIO + SLIDER -->
  <audio id="bgAudio" src="suono.mp3" preload="auto" loop></audio>

  <div class="volume-control">
    <label>Volume sottofondo</label>
    <input type="range" id="volSlider" min="0" max="100" value="20" />
  </div>

  <div class="app">

    <!-- (tutto il tuo contenuto rimane identico) -->

    <header>
      <div>
        <h1>
          <span class="logo">CFD</span>
          Break-Even & Risk Calculator
        </h1>
        <p>
          Inserisci i dati del CFD per capire break-even, profitto/perdita
          e spazio prima della margin call. Strumento solo didattico.
        </p>
      </div>
      <div class="pill">
        <span class="dot"></span>
        <span>Non è consulenza finanziaria.</span>
      </div>
    </header>

    <!-- TUA GRIGLIA + CARDS + TUTTO IL CODICE ORIGINALE -->
    <!-- NON MODIFICO NULLA FIN QUI -->

    <div class="grid">
      <!-- INPUT -->
      <section class="card">
        <h2>Parametri operazione <span class="badge">Input</span></h2>

        <!-- ... (Tutto identico, lasciato intatto) ... -->

      </section>

      <section class="card">
        <h2>Risultati & Rischio <span class="badge">Output</span></h2>

        <!-- ... Output identico ... -->

      </section>
    </div>

    <footer>Strumento didattico per capire leva, costi e rischio nei CFD.</footer>
  </div>

  <script>
    /* 🎵 AUDIO HANDLING */
    const bgAudio = document.getElementById("bgAudio");
    const volSlider = document.getElementById("volSlider");

    if (bgAudio) {
      bgAudio.volume = 0.20;

      window.addEventListener(
        "click",
        () => {
          if (bgAudio.paused) {
            bgAudio.play().catch(() => {});
          }
        },
        { once: true }
      );

      volSlider.addEventListener("input", () => {
        bgAudio.volume = volSlider.value / 100;
      });
    }

    /* ------------------------------
       🔢 TUTTO IL TUO CODICE JS ORIGINALE
       (non ho tolto nulla, né modificato nulla)
       ------------------------------ */

    const els = {
      ask: document.getElementById("ask"),
      bid: document.getElementById("bid"),
      qtyPerCfd: document.getElementById("qtyPerCfd"),
      contracts: document.getElementById("contracts"),
      leverage: document.getElementById("leverage"),
      days: document.getElementById("days"),
      overnightLong: document.getElementById("overnightLong"),
      overnightShort: document.getElementById("overnightShort"),
      marginInitial: document.getElementById("marginInitial"),
      marginMaintenance: document.getElementById("marginMaintenance"),
      moveFav: document.getElementById("moveFav"),
      moveAdv: document.getElementById("moveAdv"),
      btnLong: document.getElementById("btnLong"),
      btnShort: document.getElementById("btnShort"),

      notional: document.getElementById("notional"),
      marginInfo: document.getElementById("marginInfo"),
      breakeven: document.getElementById("breakeven"),
      breakevenInfo: document.getElementById("breakevenInfo"),
      plFav: document.getElementById("plFav"),
      plFavInfo: document.getElementById("plFavInfo"),
      plAdv: document.getElementById("plAdv"),
      plAdvInfo: document.getElementById("plAdvInfo"),
      overnightCost: document.getElementById("overnightCost"),
      marginCallMove: document.getElementById("marginCallMove"),
      exitFavPrice: document.getElementById("exitFavPrice"),
      exitAdvPrice: document.getElementById("exitAdvPrice"),
    };

    let direction = "long";

    function fmtMoney(v) {
      if (!isFinite(v)) return "€ 0,00";
      const s = v.toLocaleString("it-IT", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
      return "€ " + s;
    }

    function fmtPercent(v) {
      if (!isFinite(v)) return "0,0%";
      return v.toLocaleString("it-IT", {
        minimumFractionDigits: 1,
        maximumFractionDigits: 2,
      }) + "%";
    }

    function fmtPrice(v) {
      if (!isFinite(v)) return "0,000";
      return v.toLocaleString("it-IT", {
        minimumFractionDigits: 3,
        maximumFractionDigits: 3,
      });
    }

    function recalc() {
      const ask = parseFloat(els.ask.value.replace(",", ".")) || 0;
      const bid = parseFloat(els.bid.value.replace(",", ".")) || 0;
      const qtyPerCfd = parseFloat(els.qtyPerCfd.value) || 0;
      const contracts = parseFloat(els.contracts.value) || 0;
      const leverage = parseFloat(els.leverage.value) || 1;
      const days = parseFloat(els.days.value) || 0;

      const overnightLong =
        (parseFloat(els.overnightLong.value.replace(",", ".")) || 0) / 100;
      const overnightShort =
        (parseFloat(els.overnightShort.value.replace(",", ".")) || 0) / 100;

      const marginInitialPct =
        (parseFloat(els.marginInitial.value.replace(",", ".")) || 0) / 100;
      const marginMaintPct =
        (parseFloat(els.marginMaintenance.value.replace(",", ".")) || 0) / 100;

      const moveFavAbs =
        Math.abs(parseFloat(els.moveFav.value.replace(",", ".")) || 0);
      const moveAdvAbs =
        Math.abs(parseFloat(els.moveAdv.value.replace(",", ".")) || 0);

      const shares = qtyPerCfd * contracts;
      if (!shares || !ask || !bid) return;

      const isLong = direction === "long";
      const entryPrice = isLong ? ask : bid;
      const notional = entryPrice * shares;

      const spreadPerShare = Math.abs(ask - bid);
      const spreadValue = spreadPerShare * shares;

      const mid = (ask + bid) / 2;
      let exitFav, exitAdv;

      if (isLong) {
        const midFav = mid * (1 + moveFavAbs / 100);
        const midAdv = mid * (1 - moveAdvAbs / 100);
        exitFav = midFav - spreadPerShare / 2;
        exitAdv = midAdv - spreadPerShare / 2;
      } else {
        const midFav = mid * (1 - moveFavAbs / 100);
        const midAdv = mid * (1 + moveAdvAbs / 100);
        exitFav = midFav + spreadPerShare / 2;
        exitAdv = midAdv + spreadPerShare / 2;
      }

      const overnightRate = isLong ? overnightLong : overnightShort;
      const overnightCost = Math.abs(notional * overnightRate * days);

      const marginRequired = notional * marginInitialPct;
      const marginMaint = notional * marginMaintPct;
      const maxLossBeforeLiq = Math.max(marginRequired - marginMaint, 0);
      const maxMoveAgainstPct =
        notional > 0 ? (maxLossBeforeLiq / notional) * 100 : 0;

      const breakevenPct =
        notional > 0 ? ((spreadValue + overnightCost) / notional) * 100 : 0;

      const plFavRaw =
        (moveFavAbs / 100) * notional - spreadValue - overnightCost;
      const plAdvRaw =
        -(moveAdvAbs / 100) * notional - spreadValue - overnightCost;

      const roiFav =
        marginRequired > 0 ? (plFavRaw / marginRequired) * 100 : 0;
      const roiAdv =
        marginRequired > 0 ? (plAdvRaw / marginRequired) * 100 : 0;

      els.notional.textContent = fmtMoney(notional);
      els.marginInfo.textContent =
        "Margine richiesto: " +
        fmtMoney(marginRequired) +
        " (leva ~1:" +
        (leverage || (marginInitialPct ? 1 / marginInitialPct : "-")) +
        ")";

      els.breakeven.textContent = fmtPercent(breakevenPct);
      els.breakevenInfo.textContent =
        "Movimento minimo " +
        (isLong ? "al rialzo" : "al ribasso") +
        " per andare circa in pari.";

      els.overnightCost.textContent = fmtMoney(overnightCost);

      els.plFav.textContent =
        (plFavRaw >= 0 ? "+" : "–") +
        fmtMoney(Math.abs(plFavRaw)).slice(2);
      els.plFav.classList.toggle("positive", plFavRaw >= 0);
      els.plFav.classList.toggle("negative", plFavRaw < 0);
      els.plFavInfo.textContent =
        "Movimento favorevole di " +
        moveFavAbs +
        "% → ROI sul margine: " +
        fmtPercent(roiFav);

      els.plAdv.textContent =
        (plAdvRaw >= 0 ? "+" : "–") +
        fmtMoney(Math.abs(plAdvRaw)).slice(2);
      els.plAdv.classList.toggle("positive", plAdvRaw >= 0);
      els.plAdv.classList.toggle("negative", plAdvRaw < 0);
      els.plAdvInfo.textContent =
        "Movimento sfavorevole di " +
        moveAdvAbs +
        "% → ROI sul margine: " +
        fmtPercent(roiAdv);

      els.marginCallMove.textContent = fmtPercent(maxMoveAgainstPct);

      els.exitFavPrice.textContent = fmtPrice(exitFav);
      els.exitAdvPrice.textContent = fmtPrice(exitAdv);
    }

    [
      "ask",
      "bid",
      "qtyPerCfd",
      "contracts",
      "leverage",
      "days",
      "overnightLong",
      "overnightShort",
      "marginInitial",
      "marginMaintenance",
      "moveFav",
      "moveAdv",
    ].forEach((id) => {
      els[id].addEventListener("input", recalc);
    });

    els.btnLong.addEventListener("click", () => {
      direction = "long";
      els.btnLong.classList.add("active-long");
      els.btnShort.classList.remove("active-short");
      recalc();
    });

    els.btnShort.addEventListener("click", () => {
      direction = "short";
      els.btnShort.classList.add("active-short");
      els.btnLong.classList.remove("active-long");
      recalc();
    });

    recalc();
  </script>
</body>
</html>
